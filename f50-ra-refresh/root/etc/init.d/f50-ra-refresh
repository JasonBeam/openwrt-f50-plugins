#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/f50-ra-refresh --watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param file /etc/config/f50_ra
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger f50_ra; }
