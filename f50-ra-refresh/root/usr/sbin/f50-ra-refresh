#!/bin/sh
# SPDX-License-Identifier: MIT
# Observe authentic RA renewals. Never fabricate/delete routes or restart networking.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
STATE=/var/run/f50-ra-refresh.state
LOCK=/var/run/f50-ra-refresh.lock
TAG=f50-ra-refresh

load_settings() {
	enabled=$(uci -q get f50_ra.main.enabled)
	network=$(uci -q get f50_ra.main.network); network=${network:-wan}
	prefix=$(uci -q get f50_ra.main.device_prefix); prefix=${prefix:-sipa_eth}
	interval=$(uci -q get f50_ra.main.interval); interval=${interval:-3600}
	threshold=$(uci -q get f50_ra.main.threshold); threshold=${threshold:-7200}
	case "$network" in ''|*[!a-zA-Z0-9_]*|?????????????????????????????????*) return 1 ;; esac
	case "$prefix" in ''|*[!a-zA-Z0-9_.:-]*|????????????????*) return 1 ;; esac
	case "$interval:$threshold" in *[!0-9:]*|:*|*:) return 1 ;; esac
	case "$interval:$threshold" in 0*|*:0*) return 1 ;; esac
	[ ${#interval} -le 6 ] && [ ${#threshold} -le 6 ] || return 1
	[ "$interval" -ge 60 ] && [ "$interval" -le 86400 ] || return 1
	[ "$threshold" -ge 60 ] && [ "$threshold" -le 604800 ] || return 1
	adaptive=$(uci -q get f50_ra.main.adaptive); adaptive=${adaptive:-1}
	case "$adaptive" in 0|1) ;; *) return 1 ;; esac
	configured_interval=$interval; configured_threshold=$threshold
	tool=''
	for candidate in /usr/bin/rdisc6 /usr/sbin/rdisc6 /usr/libexec/f50-rdisc6; do
		[ -x "$candidate" ] && { tool=$candidate; break; }
	done
	return 0
}

number() {
    case "$1" in ''|*[!0-9]*) return 1 ;; 0) return 0 ;; 0*) return 1 ;; esac
    [ "${#1}" -le 9 ] && [ "$1" -le 100000000 ]
}
snapshot() {
    status=$(ubus -t 5 call "network.interface.$network" status 2>/dev/null) || return 1
    [ "$(printf '%s' "$status" | jsonfilter -e '@.up')" = true ] || return 1
    dev=$(printf '%s' "$status" | jsonfilter -e '@.l3_device')
    case "$dev" in ''|*[!a-zA-Z0-9_.:-]*|????????????????*) return 1 ;; esac
    case "$dev" in "$prefix"*) ;; *) return 1 ;; esac
    index=$(cat "/sys/class/net/$dev/ifindex" 2>/dev/null) || return 1
    number "$index" || return 1
    route=$(ip -6 route show default dev "$dev" proto ra 2>/dev/null | head -n 1)
    remaining=$(printf '%s\n' "$route" | awk '{for(i=1;i<=NF;i++) if($i=="expires") {v=$(i+1); sub(/sec$/, "", v); print v; exit}}')
    gateway=$(printf '%s\n' "$route" | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1);exit}}')
    now=$(cut -d. -f1 /proc/uptime)
    boot=$(cat /proc/sys/kernel/random/boot_id)
    number "$now" || return 1
    case "$boot" in ''|*[!a-zA-Z0-9-]*) return 1 ;; esac
    case "$gateway" in *[!a-fA-F0-9:.%]*) return 1 ;; esac
    identity="$boot/$dev/$index/$gateway"
}
reset_observation() {
    previous=0; previous_remaining=0; lifetime=0; source=observed
    last_natural=0; natural_interval=0; renewals=0; event=baseline; last_request=0
}
load_state() {
    reset_observation
    [ -r "$STATE" ] || return 0
    {
        IFS= read -r saved_identity
        read -r previous previous_remaining lifetime source last_natural natural_interval renewals event last_request extra
    } < "$STATE"
    valid=1
    for n in "$previous" "$previous_remaining" "$lifetime" "$last_natural" "$natural_interval" "$renewals" "$last_request"; do
        number "$n" || valid=0
    done
    [ -z "$extra" ] || valid=0
    [ "$previous" -le "$now" ] 2>/dev/null || valid=0
    case "$source" in observed|advertised) ;; *) valid=0 ;; esac
    case "$event" in baseline|natural|solicited|failed) ;; *) valid=0 ;; esac
    if [ "$valid" != 1 ] || [ "$saved_identity" != "$identity" ]; then reset_observation; fi
}
save_state() {
    umask 077
    {
        printf '%s\n' "$identity"
        printf '%s %s %s %s %s %s %s %s %s\n' "$now" "${remaining:-0}" "$lifetime" "$source" "$last_natural" "$natural_interval" "$renewals" "$event" "$last_request"
    } > "$STATE.new" && mv "$STATE.new" "$STATE"
}
policy() {
    interval=$configured_interval; threshold=$configured_threshold
    [ "$adaptive" = 1 ] || return 0
    # Before learning a full lifetime, use the observed remaining as a lower bound.
    threshold=$((lifetime / 4))
    [ "$threshold" -ge 30 ] || threshold=30
    [ "$threshold" -le 7200 ] || threshold=7200
    [ "$threshold" -le "$configured_threshold" ] || threshold=$configured_threshold
    interval=60
    if number "$remaining"; then
        [ "$remaining" -ge 240 ] || interval=10
    else
        interval=30
    fi
}
observe() {
    number "$remaining" || return 0
    if [ "$previous" -gt 0 ] && [ "$now" -ge "$previous" ]; then
        elapsed=$((now - previous))
        expected=$((previous_remaining - elapsed))
        [ "$expected" -ge 0 ] || expected=0
        if [ "$remaining" -gt $((expected + 5)) ]; then
            # A delayed reply to our own RS is not a natural-cadence sample.
            if [ "$last_request" -gt 0 ] && [ $((now - last_request)) -le 30 ]; then
                last_natural=0
                return 0
            fi
            if [ "$last_natural" -gt 0 ]; then natural_interval=$((now - last_natural)); fi
            last_natural=$now
            renewals=$((renewals + 1))
            lifetime=$remaining; source=observed; event=natural
            logger -t "$TAG" "Observed RA lifetime jump on $dev; remaining=${remaining}s; sampled_interval=${natural_interval}s (approximate)"
        fi
    fi
    [ "$lifetime" -gt 0 ] || lifetime=$remaining
}
solicit() {
    "$tool" -1 -n -r 2 -w 3000 "$@"
}
request_ra() {
    before=${remaining:-0}; request_identity=$identity; request_start=$now; last_request=$now
    request_gateway=$gateway; request_link="$boot/$dev/$index"
    logger -t "$TAG" "Requesting RA on $dev; previous lifetime=${remaining:-missing}"
    # Standard all-routers multicast: this carrier ignores unicast RS.
    reply=$(solicit "$dev" 2>&1)
    rc=$?
    advertised=$(printf '%s\n' "$reply" | awk 'tolower($0) ~ /router lifetime/ {sub(/^.*:/, ""); for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) {print $i; exit}}')
    reply_router=$(printf '%s\n' "$reply" | awk '$1=="from" {print $2;exit}')
    sleep 2
    if ! snapshot || { [ -n "$request_gateway" ] && [ "$identity" != "$request_identity" ]; } || [ "$boot/$dev/$index" != "$request_link" ]; then
        echo 'WAN/router changed during request; no state carried across'
        remaining=''
        return 1
    fi
    number "$before" || before=0
    expected=$((before - (now - request_start)))
    [ "$expected" -ge 0 ] || expected=0
    last_natural=0 # A solicited response is not evidence of natural RA cadence.
    near_full=0
    if number "$advertised" && [ "$advertised" -gt 0 ] && [ "$reply_router" = "$gateway" ] && number "$remaining"; then
        if [ "$remaining" -le "$advertised" ] && [ "$remaining" -ge $((advertised - 10)) ]; then near_full=1; fi
    fi
    if [ "$rc" = 0 ] && number "$remaining" && { [ "$remaining" -gt $((expected + 5)) ] || [ "$near_full" = 1 ]; }; then
        lifetime=$remaining; source=observed; event=solicited
        if number "$advertised" && [ "$advertised" -gt 0 ] && [ "$advertised" -ge "$remaining" ] && [ "$reply_router" = "$gateway" ]; then
            lifetime=$advertised; source=advertised
        fi
        echo "RA renewed: remaining=${remaining}s; lifetime=${lifetime}s ($source)"
        logger -t "$TAG" "Verified RA renewal on $dev; remaining=${remaining}s; lifetime=${lifetime}s ($source)"
        return 0
    fi
    event=failed
    echo "RA renewal not verified: RS exit=$rc; remaining=${remaining:-missing}; routes unchanged"
    logger -t "$TAG" "RA renewal not verified on $dev; RS exit=$rc; routes unchanged"
    return 1
}
step() (
    load_settings || exit 2
    [ "$enabled" = 1 ] || { echo 'RA refresh disabled'; exit 0; }
    exec 9>"$LOCK"
    flock -n 9 || exit 0
    if ! snapshot; then
        umask 077; : > "$STATE"
        echo 'WAN not ready; skipped'
        exit 0
    fi
    load_state
    observe
    policy
    result=0
    if [ "$1" = --force ] || [ -z "$route" ] || { number "$remaining" && [ "$remaining" -le "$threshold" ]; }; then
        if [ -n "$tool" ]; then
            request_ra || result=1
        else
            echo 'Trusted rdisc6 is missing; no request made'
            result=1
        fi
    elif ! number "$remaining"; then
        echo 'RA lifetime not numeric; left unchanged'
        exit 0
    fi
    number "$remaining" && save_state
    exit "$result"
)
show_status() (
    load_settings || { printf '{"ok":false,"error":"invalid_config"}\n'; exit 1; }
    ready=false; snapshot && ready=true
    reset_observation
    if [ "$ready" = true ]; then
        load_state
        if [ "$lifetime" = 0 ] && number "$remaining"; then lifetime=$remaining; fi
    else
        dev=''; remaining=''
    fi
    policy
    [ "$enabled" = 1 ] && enabled_json=true || enabled_json=false
    [ "$adaptive" = 1 ] && adaptive_json=true || adaptive_json=false
    [ -n "$tool" ] && tool_json=true || tool_json=false
    number "$remaining" && remaining_json=$remaining || remaining_json=null
    [ "$lifetime" -gt 0 ] && lifetime_json=$lifetime || lifetime_json=null
    [ "$natural_interval" -gt 0 ] && natural_json=$natural_interval || natural_json=null
    printf '{"ok":true,"enabled":%s,"wan_ready":%s,"device":"%s","remaining":%s,"interval":%s,"threshold":%s,"tool_available":%s,"adaptive":%s,"lifetime":%s,"lifetime_source":"%s","natural_interval":%s,"observed_renewals":%s,"last_event":"%s"}\n' \
        "$enabled_json" "$ready" "$dev" "$remaining_json" "$interval" "$threshold" "$tool_json" \
        "$adaptive_json" "$lifetime_json" "$source" "$natural_json" "$renewals" "$event"
)

case "${1:-}" in
    --watch)
        while :; do
            step ''
            wait_for=30
            if load_settings; then
                if [ "$enabled" = 1 ] && snapshot; then load_state; policy; wait_for=$interval; fi
            fi
            sleep "$wait_for"
        done
        ;;
    --status) show_status ;;
    ''|--once|--force) step "${1:-}" ;;
    *) echo 'Usage: f50-ra-refresh [--status|--once|--force|--watch]'; exit 2 ;;
esac
